# ===== פרטי העסק שיופיעו על הקבלה =====
BUSINESS_NAME=שם העסק שלך
BUSINESS_ID_LABEL=עוסק פטור
BUSINESS_ID=123456789
BUSINESS_PHONE=050-0000000
BUSINESS_ADDRESS=
BUSINESS_EMAIL=
DEFAULT_DESCRIPTION=שירותי כלה
# נתיב לקובץ לוגו (PNG שקוף מומלץ) – לא חובה
LOGO_PATH=
# מספר הקבלה הראשון
RECEIPT_START_NUMBER=1001

# ===== ההודעה שתיפתח בוואטסאפ לכלה =====
# משתנים זמינים: {name} {first_name} {amount} {method} {number} {receipt_url} {business_name} {description}
# ירידת שורה: \n
# WHATSAPP_TEMPLATE=היי {first_name}, תודה! התשלום על סך {amount} התקבל.\nהקבלה: {receipt_url}

# ===== שרת =====
# הכתובת הציבורית (https) שבה השרת רץ – משמשת לקישור לתמונת הקבלה
PUBLIC_BASE_URL=https://your-bot.onrender.com
DATA_DIR=data

# ===== טלגרם (מומלץ) =====
# הטוקן מ-@BotFather
TELEGRAM_BOT_TOKEN=
# לא חובה: מחרוזת אקראית (אותיות באנגלית, ספרות, _ או -). ריק = נוצר אוטומטית מהטוקן
TELEGRAM_WEBHOOK_SECRET=
# ה-ID שלכם בטלגרם (הבוט ישלח לכם אותו בהודעה הראשונה). כמה מזהים – מופרדים בפסיק
TELEGRAM_ALLOWED_USER_IDS=

# ===== Hyp (EZcount) – קבלות רשמיות =====
# אם ממלאים את HYP_API_KEY, הקבלה תופק ב-Hyp (מספור, PDF ודיווח מהמערכת שלכם) במקום תמונה מקומית.
# המפתח נמצא ב-Hyp: התממשקויות → "מפתח API". אל תשתפו אותו ואל תעלו אותו לגיטהאב.
HYP_API_KEY=
# כתובת המייל של מי שמפתח את החיבור (נדרש ע"י Hyp)
HYP_DEVELOPER_EMAIL=
# לבדיקות בלי להפיק מסמכים אמיתיים: https://demo.ezcount.co.il (עם מפתח של סביבת הדמו)
HYP_API_BASE=https://api.ezcount.co.il
# סוג המסמך: 400 = קבלה, 320 = חשבונית מס/קבלה (לעוסק מורשה)
HYP_DOC_TYPE=400
# 1 = Hyp ישלח גם עותק במייל (אם מוגדר)
HYP_SEND_EMAIL_COPY=0
